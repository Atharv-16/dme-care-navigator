# Default: free local stack
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Gemini free tier (Google AI Studio: https://aistudio.google.com/apikey)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
# GEMINI_ANALYSIS_FALLBACK_MODEL=gemini-flash-lite-latest
# Native full-duplex voice model:
# GEMINI_NATIVE_AUDIO_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_LIVE_VOICE=Aoede
# VAD_MIN_RMS=650
# VAD_START_FRAMES=14
# VAD_START_VOTES=10
# GEMINI_MIN_INTERVAL_SEC=5
# LLM_RETRY_DELAY_SEC=10

# Optional paid OpenAI fallback:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

MAX_PARALLEL_CALLS=2
MAX_MANAGER_STEPS=12

# Live voice earpiece (python -m src --llm --live-voice)
# Browser PCM audio through one persistent Gemini Live session.
# Gemini provides STT, dialogue, TTS, turn detection, and automatic barge-in.
# Default is all: clinic, each selected supplier, and patient calls ring in the browser.
# LIVE_VOICE_ROLES=all
# To limit impersonation: LIVE_VOICE_ROLES=clinic,suppliers,patient
